# Copy to .env and fill in. Never put real values in this file — it is the one
# that gets committed.

# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# Comma-separated guild ids the bot should register slash commands in.
# Guild-scoped registration is instant; global registration takes up to an hour.
# Leave blank to register in every server the bot is currently in.
DISCORD_GUILD_IDS=

# Where the SQLite file lives.
#
# Locally, leave this alone. When deployed, leave it UNSET and attach a volume
# instead: the bot reads Railway's RAILWAY_VOLUME_MOUNT_PATH and puts the file
# on the volume by itself. Setting it to a path outside the volume is a
# startup error, because that database would be wiped on the next deploy.
DATABASE_PATH=./data/standing.db

# Optional: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# Escape hatch for throwaway test deploys: allows the bot to start on storage
# that does not survive a redeploy. Never set this on a real server.
# ALLOW_EPHEMERAL_DB=true

# Slash commands are only re-registered when their definitions change. Set this
# if you ever need to force a push to Discord.
# FORCE_COMMAND_REGISTRATION=true
